# HTTPS in front of the app. Caddy gets and renews the certificate for the
# domain by itself (Let's Encrypt), once the domain points here and port 443
# is open.

jp-master.com {
	encode zstd gzip
	reverse_proxy frontend:80
}

www.jp-master.com {
	redir https://jp-master.com{uri} permanent
}

# Anything else — the bare IP, old bookmarks — goes to the site by its name,
# where the connection is encrypted and the session cookie is sent.
:80 {
	redir https://jp-master.com{uri} permanent
}
