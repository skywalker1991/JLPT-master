# JLPT Master 环境配置
# 复制此文件为 .env 并填入实际值

# AI 服务（必填）
LLM_PROVIDER=gemini          # gemini | openai | ollama
LLM_MODEL=gemini-2.0-flash
LLM_API_KEY=your_api_key_here

# 学习目标级别
TARGET_LEVEL=N2              # N1 | N2 | N3 | N4 | N5

# 向量模型（首次启动自动下载，约 570MB）
EMBEDDING_MODEL=BAAI/bge-m3

# 数据库（Docker 内部自动配置，本地开发时取消注释）
# DATABASE_URL=postgresql+asyncpg://jlpt:jlpt@localhost:5432/jlpt
# QDRANT_URL=http://localhost:6333

# 本地开发时覆盖 JMdict 路径（Docker 内部自动正确）
# JMDICT_PATH=/Users/你的用户名/JLPT-master/backend/data/JMdict_e.xml

# 账号（必填：首次启动时用它创建第一个管理员，之前的数据都归到这个账号）
# 创建之后改这两个值不会改已有账号；改密码请在网页「账号」里改，
# 或用 docker compose exec backend python scripts/create_user.py 邮箱 --reset
ADMIN_EMAIL=
ADMIN_PASSWORD=

# 注册：closed = 只有管理员能建账号（默认）；open = 任何人都能注册
SIGNUP_MODE=closed           # closed | invite | open — invite: sign-up needs a code from 账号 → 邀请码

# 登录状态保持天数
SESSION_DAYS=30

# 站点上了 HTTPS 之后必须改成 true；纯 HTTP 下保持 false，否则登录 cookie 发不出去
COOKIE_SECURE=false
